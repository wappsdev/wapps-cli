    {
      "name": "agent_submit",
      "title": "Dispatch a job",
      "description": "Dispatch a job on a declared role side. Answers the job id and, on creation only, the job's capability, with the attention block. The Worker records the job; a daemon runs it.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "authority": {
            "type": "object",
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "fencingToken": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "capability",
              "fencingToken"
            ],
            "additionalProperties": false
          },
          "laneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "dispatchKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "base": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "head": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "workerProvider": {
            "type": "string",
            "enum": [
              "claude",
              "codex"
            ]
          },
          "workItemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reviewsJobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "resumesJobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "answersQuestionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "authority",
          "laneId",
          "role",
          "dispatchKey",
          "base",
          "head",
          "task",
          "workerProvider"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "agent_attach",
      "title": "Attach a run to a job",
      "description": "Bind a provider run (and optionally its worktree) to a job, presenting the job's own authority. Answers the job's brief.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "authority": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "capability": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "jobId",
              "capability"
            ],
            "additionalProperties": false
          },
          "providerRunId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "worktree": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "branch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "path",
              "branch"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "authority",
          "providerRunId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "agent_report",
      "title": "Report a job's end",
      "description": "Settle a job as completed, failed, timed_out or cancelled, with its output or error, presenting the job's own authority.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "authority": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "capability": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "jobId",
              "capability"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed",
              "timed_out",
              "cancelled"
            ]
          },
          "output": {
            "type": "string",
            "maxLength": 200000
          },
          "error": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "authority",
          "status"
        ],
        "additionalProperties": false
      }
    },
