            "maxLength": 20000
          }
        },
        "required": [
          "authority",
          "questionId",
          "answer"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "work_withdraw",
      "title": "Withdraw a question",
      "description": "Take back a question you raised, with a reason. Withdrawing is not answering.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "authority": {
            "type": "object",
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "fencingToken": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "capability",
              "fencingToken"
            ],
            "additionalProperties": false
          },
          "questionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
