              "capability": {
                "type": "string",
                "minLength": 1
              },
              "fencingToken": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "capability",
              "fencingToken"
            ],
            "additionalProperties": false
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "authority",
          "jobId"
        ],
        "additionalProperties": false
      }
    }
  ]
