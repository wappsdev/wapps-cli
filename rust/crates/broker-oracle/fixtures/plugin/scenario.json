{
  "plugin_commit": "c6d7e09fa0df9d8ad231fd56520a14fee4432ba5",
  "project_id": "oracle",
  "launcher_provider": "claude",
  "roles": {
    "version": 1,
    "roles": {
      "reader": {
        "description": "Reads the project and reports. The oracle's fixture role.",
        "variants": {
          "claude": {
            "model": "sonnet",
            "effort": "high",
            "mode": "read-only",
            "prompt": "prompts/reader.md",
            "tools": ["read", "grep"],
            "skills": ["superpowers:test-driven-development"]
          },
          "codex": {
            "model": "gpt-5.6-sol",
            "effort": "high",
            "mode": "read-only",
            "prompt": "prompts/reader.md",
            "tools": ["read", "grep", "find", "ls", "bash"],
            "skills": ["oracle-method"]
          }
        }
      }
    }
  },
  "prompts": {
    "prompts/reader.md": "You are the oracle's reader. Read what you are asked to read and report it.\n"
  },
  "mcp": [
    {"call": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "broker-oracle", "version": "0"}}},
    {"notify": "notifications/initialized"},
    {"call": "tools/list"},
    {"call": "ping"},
    {"tool": "orchestrator_claim", "arguments": {"missionId": "oracle"}, "capture": {"capability": "capability", "fencingToken": "fencingToken"}},
    {"tool": "orchestrator_status", "arguments": {"missionId": "oracle"}},
    {"tool": "roles_list", "arguments": {"missionId": "oracle"}},
    {"tool": "work_list", "arguments": {"missionId": "oracle"}},
    {"tool": "work_list", "arguments": {}},
    {"tool": "agent_await", "arguments": {"missionId": "oracle"}},
    {"tool": "agent_submit", "arguments": {"missionId": "oracle", "capability": "{{capability}}", "fencingToken": "{{fencingToken}}", "laneId": "oracle-codex", "role": "reader", "provider": "codex", "dispatchKey": "oracle-codex-1", "base": "main", "head": "main", "task": "Read CLAUDE.md and report the first rule."}, "capture": {"codexJob": "jobId"}},
    {"tool": "agent_status", "arguments": {"missionId": "oracle", "jobId": "{{codexJob}}"}, "until": {"state": "review_pending"}, "poll_ms": 100, "timeout_ms": 60000},
    {"tool": "agent_result", "arguments": {"missionId": "oracle", "jobId": "{{codexJob}}"}},
    {"tool": "agent_submit", "arguments": {"missionId": "oracle", "capability": "{{capability}}", "fencingToken": "{{fencingToken}}", "laneId": "oracle-claude", "role": "reader", "provider": "claude", "dispatchKey": "oracle-claude-1", "base": "main", "head": "main", "task": "Read CLAUDE.md and report the first rule."}, "capture": {"claudeJob": "jobId"}},
    {"tool": "agent_status", "arguments": {"missionId": "oracle", "jobId": "{{claudeJob}}"}, "until": {"state": "completed"}, "poll_ms": 100, "timeout_ms": 60000},
    {"tool": "agent_result", "arguments": {"missionId": "oracle", "jobId": "{{claudeJob}}"}},
    {"tool": "agent_list", "arguments": {"missionId": "oracle"}},
    {"tool": "orchestrator_release", "arguments": {"missionId": "oracle", "capability": "{{capability}}", "fencingToken": "{{fencingToken}}"}}
  ],
  "codex": [
    {"expect": {"method": "initialize"}},
    {"send": {"jsonrpc": "2.0", "id": "{{id}}", "result": {"protocolVersion": "2025-06-18", "capabilities": {"tools": {}}, "serverInfo": {"name": "codex-mcp-server", "version": "0.145.0"}}}},
    {"expect": {"method": "tools/call", "params": {"name": "codex"}}},
    {"send": {"jsonrpc": "2.0", "method": "codex/event", "params": {"msg": {"type": "session_configured", "thread_id": "0199a000-0000-7000-8000-00000000c0de", "session_id": "0199a000-0000-7000-8000-00000000c0de", "model": "gpt-5.6-sol"}}}},
    {"send": {"jsonrpc": "2.0", "method": "codex/event", "params": {"msg": {"type": "task_started"}}}},
    {"send": {"jsonrpc": "2.0", "method": "codex/event", "params": {"msg": {"type": "exec_command_begin", "command": ["/bin/zsh", "-lc", "cat CLAUDE.md"]}}}},
    {"send": {"jsonrpc": "2.0", "method": "codex/event", "params": {"msg": {"type": "token_count", "rate_limits": {"primary": {"used_percent": 12.5, "window_minutes": 300, "resets_at": 1790000000}}}}}},
    {"send": {"jsonrpc": "2.0", "method": "codex/event", "params": {"msg": {"type": "agent_message", "message": "The first rule is: say what was measured."}}}},
    {"send": {"jsonrpc": "2.0", "id": "{{id}}", "result": {"content": [{"type": "text", "text": "ORACLE: say what was measured."}]}}}
  ],
  "claude": [
    {"expect": {"type": "control_request", "request": {"subtype": "initialize"}}},
    {"send": {"type": "control_response", "response": {"subtype": "success", "request_id": "{{request_id}}", "response": {}}}},
    {"expect": {"type": "user"}},
    {"send": {"type": "system", "subtype": "init", "session_id": "0199a000-0000-7000-8000-00000000c1a0", "model": "claude-sonnet-4-5", "cwd": "", "tools": ["Read", "Grep"], "permissionMode": "bypassPermissions"}},
    {"send": {"type": "rate_limit_event", "rate_limit_info": {"status": "allowed", "utilization": 0.25, "rateLimitType": "five_hour", "resetsAt": 1790000000}, "session_id": "0199a000-0000-7000-8000-00000000c1a0"}},
    {"send": {"type": "assistant", "session_id": "0199a000-0000-7000-8000-00000000c1a0", "parent_tool_use_id": null, "message": {"id": "msg_oracle", "type": "message", "role": "assistant", "model": "claude-sonnet-4-5", "content": [{"type": "text", "text": "The first rule is: say what was measured."}], "stop_reason": "end_turn", "usage": {"input_tokens": 1, "output_tokens": 1}}}},
    {"send": {"type": "result", "subtype": "success", "is_error": false, "result": "ORACLE: say what was measured.", "session_id": "0199a000-0000-7000-8000-00000000c1a0", "duration_ms": 1, "duration_api_ms": 1, "num_turns": 1, "total_cost_usd": 0, "usage": {"input_tokens": 1, "output_tokens": 1}}}
  ]
}
